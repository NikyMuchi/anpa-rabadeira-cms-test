---
layout: layouts/base.njk
---
<article class="post-single container">
  <a href="/novas/" class="post-single__back">← Voltar a Novas</a>
  <header>
    {% if category %}
    <span class="post-single__category">{{ category }}</span>
    {% endif %}
    <h1>{{ title }}</h1>
    <time class="post-single__date" datetime="{{ date | isoDate }}">
      📅 {{ date | dataGalega }}
    </time>
    {% if image %}
    <img src="{{ image }}" alt="{{ title }}" class="post-single__image">
    {% endif %}
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
</article>
