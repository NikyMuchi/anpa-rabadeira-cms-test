<!DOCTYPE html>
<html lang="gl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/jpeg" href="/img/logo-anpa.jpg">
  <link rel="shortcut icon" type="image/jpeg" href="/img/logo-anpa.jpg">
  <link rel="apple-touch-icon" href="/img/logo-anpa.jpg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div style="background-color: #f59e0b; color: #78350f; font-weight: 700; font-size: 0.875rem; text-align: center; padding: 0.5rem 1rem; border-bottom: 2px solid #d97706; letter-spacing: 0.025em;" role="alert">
    ⚠️ ENTORNO DE PROBAS — CMS TEST (Repositorio e contorno illados)
  </div>
  <a href="#main" class="skip-link">Saltar ao contido</a>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-brand" aria-label="Inicio - {{ site.name }}">
        <img src="/img/logo-anpa.jpg" alt="Logo {{ site.name }}" class="site-brand__logo">
        <div class="site-brand__text">
          <span class="site-brand__name">ANPA Rabadeira</span>
          <span class="site-brand__sub">CEIP Rabadeira</span>
        </div>
      </a>

      <button class="nav-toggle" aria-expanded="false" aria-label="Abrir menú">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <nav class="main-nav" aria-label="Menú principal">
        {%- for pg in collections.navPages %}
        <a href="{{ pg.url or pg.data.permalink }}"{% if page.url == (pg.url or pg.data.permalink) or ((pg.url or pg.data.permalink) != '/' and page.url.startsWith(pg.url or pg.data.permalink)) %} aria-current="page"{% endif %}>{{ pg.data.navLabel or pg.data.title }}</a>
        {%- endfor %}
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-about">
          <h3>{{ site.name }}</h3>
          <p>{{ site.fullName }}. Traballando pola educación e o benestar das nosas fillas e fillos.</p>
        </div>
        <div class="footer-links">
          <h3>Acceso rápido</h3>
          <ul>
            <li><a href="/">Inicio</a></li>
            {%- for pg in collections.navPages %}
            <li><a href="{{ pg.url or pg.data.permalink }}">{{ pg.data.title }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <div class="footer-contact">
          <h3>Contacto</h3>
          <p>📧 <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
          <p>🏫 CEIP Rabadeira, Oleiros (A Coruña)</p>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>&copy; 2026 {{ site.name }}. Feito con 💙 para a comunidade educativa.</p>
        <p><a href="/admin/" class="footer-admin-link">🔒 Acceso administración</a></p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.init({ locale: 'es' });
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
